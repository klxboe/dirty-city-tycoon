<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Axe Throw Master</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  Export-Compliance-Frage bei jedem TestFlight-Upload umgehen: die App nutzt
	  ausschließlich Standard-HTTPS/TLS (über AdMob/RevenueCat-SDKs, siehe ads.ts/
	  purchases.ts), keine eigene/zusätzliche Verschlüsselung – exakt der Fall, den
	  Apple mit "Keinen der oben genannten Algorithmen" im Dokumentations-Dialog
	  meint. Mit diesem Schlüssel weiß App Store Connect das schon beim Upload und
	  fragt nicht mehr manuell nach.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!--
	  AdMob (siehe src/game/ads.ts). GADApplicationIdentifier steht hier auf Googles
	  offizieller TEST-App-ID (siehe https://developers.google.com/admob/ios/test-ads),
	  passend zu `USE_TEST_AD = true` dort – MUSS zusammen mit `USE_TEST_AD`/
	  `REAL_APP_ID` in ads.ts auf die ECHTE, für Axe Throw neu angelegte AdMob-App-ID
	  umgestellt werden, bevor echt eingereicht wird.
	  SKAdNetworkItems: nur Googles eigene ID eingetragen (sicher bekannt, seit Jahren
	  stabil dieselbe) – die VOLLE von Google empfohlene Liste (deutlich mehr Einträge
	  für Mediation-Netzwerke) MUSS vor der echten Einreichung aus der aktuellen
	  offiziellen AdMob-Doku ergänzt werden, hier absichtlich NICHT erfunden/geraten.
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
