# nur lokale Build-Artefakte/Abhängigkeiten sind, nicht.
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
