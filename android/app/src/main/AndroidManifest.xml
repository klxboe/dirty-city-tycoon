<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
          AdMob braucht diese App-ID nativ im Manifest, sonst crasht die App beim Start
          (@capacitor-community/admob). Das hier ist Googles OFFIZIELLE, öffentlich
          dokumentierte Android-Test-App-ID (https://developers.google.com/admob/android/test-ads)
          - noch KEINE echte ID, weil AdMob-Apps pro Plattform getrennt angelegt werden
          (die echte iOS-App-ID aus Info.plist gilt NICHT für Android). Vor einer echten
          Veröffentlichung: in apps.admob.com eine eigene Android-App + Rewarded-/
          Interstitial-Ad-Units anlegen (analog zum iOS-Vorgehen, siehe game/ads.ts),
          dann diesen Wert UND die Android-spezifischen Ad-Unit-IDs in ads.ts ergänzen.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
